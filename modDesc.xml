<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<modDesc descVersion="72">
    <author>Timo</author>
    <version>1.0.2.0</version>
    <title>
        <en>Throttle Hold</en>
    </title>
    <description>
        <en><![CDATA[Keep a vehicle applying throttle after you exit it - perfect for pulling a stuck tractor out with a second tractor while the stuck one keeps driving.

Controls (while sitting in the vehicle and holding the left + right mouse button, all rebindable):
- Left Ctrl + T: arm / disarm throttle hold
- Left Ctrl + Page Up / Page Down: change throttle percentage (5% - 100%)
- Left Ctrl + G: switch direction (forward / reverse)

Arm it, set the percentage, exit the vehicle, hop into your other tractor and pull. The throttle is only applied while nobody is driving the vehicle.]]></en>
    </description>
    <iconFilename>icon_throttleHold.dds</iconFilename>
    <multiplayer supported="true" />

    <extraSourceFiles>
        <sourceFile filename="scripts/ThrottleHoldEvent.lua" />
        <sourceFile filename="scripts/register.lua" />
    </extraSourceFiles>

    <specializations>
        <specialization name="throttleHold" className="ThrottleHold" filename="scripts/ThrottleHold.lua" />
    </specializations>

    <actions>
        <action name="THROTTLEHOLD_TOGGLE" category="VEHICLE" />
        <action name="THROTTLEHOLD_UP" category="VEHICLE" />
        <action name="THROTTLEHOLD_DOWN" category="VEHICLE" />
        <action name="THROTTLEHOLD_DIRECTION" category="VEHICLE" />
    </actions>

    <inputBinding>
        <actionBinding action="THROTTLEHOLD_TOGGLE">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_t" />
        </actionBinding>
        <actionBinding action="THROTTLEHOLD_UP">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_pageup" />
        </actionBinding>
        <actionBinding action="THROTTLEHOLD_DOWN">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_pagedown" />
        </actionBinding>
        <actionBinding action="THROTTLEHOLD_DIRECTION">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_g" />
        </actionBinding>
    </inputBinding>

    <l10n>
        <text name="input_THROTTLEHOLD_TOGGLE"><en>Throttle hold: arm / disarm</en></text>
        <text name="input_THROTTLEHOLD_UP"><en>Throttle hold: increase %</en></text>
        <text name="input_THROTTLEHOLD_DOWN"><en>Throttle hold: decrease %</en></text>
        <text name="input_THROTTLEHOLD_DIRECTION"><en>Throttle hold: change direction</en></text>

        <text name="throttleHold_arm"><en>Arm throttle hold (%d%% %s)</en></text>
        <text name="throttleHold_disarm"><en>Disarm throttle hold (%d%% %s)</en></text>
        <text name="throttleHold_up"><en>Throttle hold +%d%%</en></text>
        <text name="throttleHold_down"><en>Throttle hold -%d%%</en></text>
        <text name="throttleHold_direction"><en>Throttle hold direction: %s</en></text>
        <text name="throttleHold_forward"><en>forward</en></text>
        <text name="throttleHold_reverse"><en>reverse</en></text>
        <text name="throttleHold_armedInfo"><en>THROTTLE HOLD ARMED: %d%% %s - applies when you exit the vehicle</en></text>
    </l10n>
</modDesc>
